# Production (Droplet — Postgres runs in Docker on the same server)
# Copy to .env before: docker compose -f docker-compose.prod.yml up -d --build

# --- Traefik / domains ---
ACME_EMAIL=you@marinapizzas.com.au
API_DOMAIN=api.marinapizzas.com.au
WEB_DOMAIN=marinapizzas.com.au
WEB_WWW_DOMAIN=www.marinapizzas.com.au
ADMIN_DOMAIN=admin.marinapizzas.com.au

FRONTEND_DIR=../piza-front
NEXT_PUBLIC_API_URL=https://api.marinapizzas.com.au/api

# --- PostgreSQL (Docker service name: postgres) ---
POSTGRES_DB=marinapizzas
POSTGRES_USER=piza
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# DATABASE_URL is built automatically in docker-compose.prod.yml — do not point at HOST placeholders.

# --- API ---
NODE_ENV=production
CORS_ORIGIN=https://marinapizzas.com.au,https://www.marinapizzas.com.au,https://admin.marinapizzas.com.au,https://pos.marinapizzas.com.au

JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=1d

ADMIN_SEED_EMAIL=admin@leovorno.com
ADMIN_SEED_PASSWORD=ChangeMe!2026
ADMIN_SEED_FIRST_NAME=Marina
ADMIN_SEED_LAST_NAME=Admin

# First deploy only: set RUN_SEED=true once, then false forever
RUN_MIGRATIONS=true
RUN_SEED=true

# --- Linkly Cloud (POS card terminal) ---
LINKLY_ENV=sandbox
# LINKLY_AUTH_BASE=https://auth.sandbox.cloud.pceftpos.com
# LINKLY_REST_BASE=https://rest.pos.sandbox.cloud.pceftpos.com/v1
LINKLY_SECRET_ENCRYPTION_KEY=replace-with-a-long-random-secret-min-32-chars
# Fixed UUID for Marina POS product (same across all stores)
LINKLY_POS_VENDOR_ID=a256b7ec-709d-4c7d-8ffe-57cc7ca1fd22

# --- Traefik dynamic storefront hosts (custom domains) ---
# Synced by API from HQ Domains into this directory (storefronts.yml).
# TRAEFIK_DYNAMIC_DIR=/app/traefik-dynamic

# --- Email (Resend preferred, else SMTP) ---
# Used for purchase-order PDFs to suppliers and daily low-stock alerts.
MAIL_FROM=Marina Pizzas <orders@marinapizzas.com.au>
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- Stripe (legacy / unused for POS card; optional) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Sentry error monitoring ---
# 1) https://sentry.io → Create org → NestJS project "piza-api"
# 2) Paste DSN below (also set NEXT_PUBLIC_SENTRY_DSN for piza-front build)
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# Frontend (baked at docker build via compose build-arg)
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<front-project>

# --- POS app (sibling clone on Droplet) ---
POS_DIR=../piza-pos
POS_DOMAIN=pos.marinapizzas.com.au
NEXT_PUBLIC_POS_API_URL=https://api.marinapizzas.com.au/api
